# --- Core ---
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production

# --- Database ---
# SQLite is used automatically if DATABASE_URL is not set (good for demos / single-clinic installs).
# For production, point this at Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/recall
DATABASE_URL=

# --- WhatsApp provider ---
# Choose one: "twilio" or "meta"
WHATSAPP_PROVIDER=twilio

# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta (WhatsApp Cloud API)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=change-this-verify-token
